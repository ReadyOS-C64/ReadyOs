; Experimental GDOS ABI v1: reserved slice of the ReadyOS schema-v5 bank.
BRIDGE_CONTROL_BANK = 71
BRIDGE_CONTROL_OFF = $FD40
BRIDGE_VERSION = 1
BRIDGE_READY_RAM = 64
BRIDGE_GDOS_RAM = 66
; Banks 65/67-70 remain reserved; no cartridge state in this prototype.
BRIDGE_CURRENT = $0700
BRIDGE_TARGET = $0701
BRIDGE_RESUME = $0702
BRIDGE_SP = $0704
BRIDGE_PROOF = $0705
BRIDGE_IDE_ROM = $0706           ; zero = no IDE64; otherwise v4.1 STD status
BRIDGE_VALID = $0707
BRIDGE_WORK_PAGE = $0708
BRIDGE_DIRECTION = $0709
BRIDGE_FAILPROBE = $070A
BRIDGE_LAST_ERROR = $070B
