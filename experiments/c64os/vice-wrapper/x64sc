#!/usr/bin/env python3
"""Add private IDE64 hardware to the normal run.sh VICE invocation."""
import os
from pathlib import Path
import shutil
import sys
import time

env = Path(os.environ["READYOS_BRIDGE_ENV"]).resolve()
pidfile = env / "readyos/vice.pid"
if pidfile.exists():
    previous_pid = int(pidfile.read_text())
    try:
        os.kill(previous_pid, 0)
    except ProcessLookupError:
        pass
    else:
        raise SystemExit(f"Experiment process {previous_pid} is still running; close it before reopening its HDD")
support = env / "runtime/vice support"
binary_port = int(os.environ.get("READYOS_BRIDGE_BINARY_PORT", "6511"))
text_port = int(os.environ.get("READYOS_BRIDGE_TEXT_PORT", "6611"))
args = sys.argv[1:]
# VICE's PRG autostart aborts when IDEDOS enters cartridge code, and can
# substitute a temporary autostart floppy. Boot PREBOOT from the real D81.
index = args.index("-autostart")
del args[index:index + 2]
for flag in ("-8", "-logfile"):
    index = args.index(flag) + 1
    if flag == "-8":
        source = Path(args[index]).resolve()
        target = env / "readyos/readyos.d81"
        # Keep the runtime copy (including user changes) on an unchanged build.
        stamp = target.with_suffix(".source")
        identity = f"{source}\n{source.stat().st_mtime_ns}\n{source.stat().st_size}\n"
        if not stamp.exists() or stamp.read_text() != identity:
            if target.exists():
                backups = target.parent / "runtime-backups"
                backups.mkdir(exist_ok=True)
                shutil.copy2(target, backups / f"readyos-{time.time_ns()}.d81")
            shutil.copy2(source, target)
            stamp.write_text(identity)
        args[index] = str(target)
    else:
        args[index] = str(env / "readyos/vice.log")
extra = []
if os.environ.get("READYOS_BRIDGE_IDE64", "1") != "0":
    extra += ["-cartcrt", str(support / "idedos20190819-c64.crt"),
              "-IDE64version", "1", "-IDE64autosize1",
              "-IDE64image1", str(support / "c64os v1.09.hdd")]
extra += ["-binarymonitor", "-binarymonitoraddress", f"127.0.0.1:{binary_port}",
         "-remotemonitor", "-remotemonitoraddress", f"127.0.0.1:{text_port}",
         "-controlport1device", "9", "-controlport2device", "0", "-mouse",
         "-keybuf", 'load"*",8\nrun\n',
         "-warp", "-drive8truedrive", "+trapdevice8",
         "+saveres", "+confirmonexit", "+sound"]
vice = os.environ["READYOS_BRIDGE_VICE"]
if os.environ.get("READYOS_BRIDGE_CONSOLE") == "1":
    extra += ["-console"]
pidfile.write_text(str(os.getpid()) + "\n")
os.execv(vice, [vice, "-default", *args, *extra])
