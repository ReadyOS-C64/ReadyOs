{
  "extends": "precog-ultimate",
  "id": "precog-ultimate-gdos",
  "display_name": "precog ultimate GDOS bridge experiment",
  "default_run": false,
  "catalog_source": "experiments/gdos64/ultimate.ini",
  "disk_overrides": [
    {
      "index": 1,
      "append_contents": [
        {
          "artifact": "gdos64.prg",
          "name": "gdos64",
          "type": "prg"
        }
      ]
    },
    {
      "index": 2,
      "mount_on_boot": false,
      "remove_contents": [
        "c64os",
        "gdos64",
        "app.c64os",
        "app.gdos64"
      ]
    }
  ],
  "bridge_setup_doc": "docs/gdos64/ultimate.md",
  "release_description": "Full Ultimate app set with the GDOS64 bridge, compiled REU skip 71, native return installer and setup guide. Drive 8 holds ReadyOS; the examples disk is optional while the target OS uses its own storage."
}
